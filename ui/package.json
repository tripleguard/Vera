{
  "name": "vera",
  "description": "Vera - voice AI assistant",
  "author": "TripleGuard",
  "version": "1.1.1",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:renderer",
    "build:renderer": "tsc && vite build",
    "build:app": "npm run build:renderer && electron-builder --win dir",
    "electron:start": "chcp 65001>nul && node start.js",
    "start": "chcp 65001>nul && node dev-start.js"
  },
  "build": {
    "appId": "ru.agentvera.desktop",
    "productName": "Vera",
    "executableName": "Vera",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "../vera.ico",
      "signExecutable": false
    }
  },
  "dependencies": {
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.292.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.0.2",
    "vite": "^8.0.16"
  }
}
